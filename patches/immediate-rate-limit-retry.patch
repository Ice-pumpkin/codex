+// RetryTelemetryCapture uses a thread-local subscriber. All spawned tasks must stay on
+// this runtime's thread; the shared multi-thread test helper loses that subscriber.
+fn run_retry_test_with_large_stack<F, Fut>(name: &str, test: F) -> Result<()>
+where
+    F: FnOnce() -> Fut + Send + 'static,
+    Fut: std::future::Future<Output = Result<()>> + 'static,
+{
+    let handle = std::thread::Builder::new()
+        .name(name.to_string())
+        .stack_size(16 * 1024 * 1024)
+        .spawn(move || {
+            tokio::runtime::Builder::new_current_thread()
+                .enable_all()
+                .build()?
+                .block_on(Box::pin(test()))
+        })?;
+    handle
+        .join()
+        .map_err(|_| anyhow::anyhow!("{name} panicked"))?
+}
